<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER"
      spacing="20.0"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fernandomadrid.practicape.controller.PersonasController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label fx:id="welcomeText" />
   <HBox prefHeight="100.0"
         prefWidth="200.0"
   spacing="20">
      <children>
          <TextField fx:id="txtNombres" promptText="introducir Nombre"/>
          <TextField fx:id="txtEdad" promptText="introducir Edad"/>

          <Button fx:id="Eliminar" onMouseClicked="#onEliminarButtonClick" text="Eliminar" />
          <Button fx:id="Añadir" onMouseClicked="#onAnadirButtonClick" text="Añadir" />
          <Button fx:id="Modificar" onMouseClicked="#onModificarButtonClick" text="Modificar"/>
      </children>
   </HBox>
    <TableView fx:id="tblTabla">
        <columns>
            <TableColumn fx:id="colNombre" text="NOMBRE"/>
            <TableColumn fx:id="colEdad" text="EDAD"/>
        </columns>
    </TableView>
</VBox>
